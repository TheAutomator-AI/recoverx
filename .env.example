# RecoverX Environment Configuration

# Backend Settings
# Local default: sqlite:///recoverx.db (automatically resolved to repository root)
# Vercel serverless default: sqlite:////tmp/recoverx.db
# PostgreSQL / Supabase / Neon: postgresql://user:password@host:port/dbname
DATABASE_URL=sqlite:///recoverx.db
APP_NAME="RecoverX — AI Revenue Recovery API"
APP_VERSION="1.0.0"
RANDOM_SEED=42

# AI Provider Configuration ('mock' | 'openai' | 'gemini')
AI_PROVIDER=mock
AI_MODEL=gpt-4o-mini
# AI_API_BASE_URL=https://api.openai.com/v1

# Real LLM API Keys (Server-side only, never exposed to client)
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# Frontend API Configuration
# Local Development:
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Production (Vercel Same-Origin Deployment):
# NEXT_PUBLIC_API_URL=/api

